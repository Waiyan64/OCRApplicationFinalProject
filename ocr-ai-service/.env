APP_NAME=ocr-ai-service
ENV=development
LOG_LEVEL=INFO

# OCR backend preference: auto | rapidocr | tesseract
OCR_BACKEND=auto
SERVICE_AUTH_TOKEN=local-dev-ocr-service-token

# Trusted callback target (NestJS API endpoint)
NESTJS_CALLBACK_URL=http://localhost:3000/api/internal/ocr/callback
CALLBACK_AUTH_TOKEN=
CALLBACK_HMAC_SECRET=local-dev-ocr-callback-hmac

CALLBACK_TIMEOUT_SECONDS=12
CALLBACK_MAX_ATTEMPTS=3
CALLBACK_BACKOFF_SECONDS=0.5
CALLBACK_OUTBOX_DIR=data/callback-outbox
CALLBACK_OUTBOX_RETRY_SECONDS=30
REQUEST_TIMEOUT_SECONDS=20
MAX_IMAGE_BYTES=10000000
MAX_IMAGE_PIXELS=20000000
MAX_CONCURRENT_JOBS=2
MIN_REQUIRED_FIELD_CONFIDENCE=0.5
MAX_TRANSACTION_AMOUNT=1000000000

# Required for URL-based ingestion. Direct multipart upload does not use it.
ALLOWED_IMAGE_HOSTS=

ENABLE_DIAGNOSTICS=true
