PORT=3000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ocr_research

# ── OCR private service ───────────────────────────────────────────────────────
OCR_SERVICE_BASE_URL=http://localhost:8100
OCR_SERVICE_AUTH_TOKEN=local-dev-ocr-service-token
OCR_REQUEST_TIMEOUT_MS=45000
OCR_MAX_IMAGE_BYTES=10000000

# ── Callback ──────────────────────────────────────────────────────────────────
BACKEND_PUBLIC_BASE_URL=http://localhost:3000
OCR_CALLBACK_PATH=/internal/ocr/callback
OCR_CALLBACK_AUTH_TOKEN=
OCR_CALLBACK_HMAC_SECRET=local-dev-ocr-callback-hmac
OCR_CALLBACK_MAX_SKEW_SECONDS=300

# ── Auth ──────────────────────────────────────────────────────────────────────
